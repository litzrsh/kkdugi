<tableCheckConstraint id="ACA3B8FD-DEC3-54A1-A335-070034475DA9" name="KKDUGI_CREDIT_HOLD_CK_QTY">
<createdBy>litzrsh</createdBy>
<createdTime>2026-09-12 11:14:07 UTC</createdTime>
<ownerDesignName>kkdugi</ownerDesignName>
<rule>RESERVED_QTY &gt; 0 AND CAPTURED_QTY &gt;= 0 AND RELEASED_QTY &gt;= 0</rule>
