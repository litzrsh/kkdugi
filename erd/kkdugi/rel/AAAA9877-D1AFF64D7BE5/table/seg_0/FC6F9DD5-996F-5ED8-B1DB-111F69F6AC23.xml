</tableCheckConstraint>
<tableCheckConstraint id="468F0D52-EC6E-5FD1-BE51-F5693CC155E5" name="KKDUGI_CREDIT_HOLD_CK_STATE">
<createdBy>litzrsh</createdBy>
<createdTime>2026-09-12 11:14:07 UTC</createdTime>
<ownerDesignName>kkdugi</ownerDesignName>
<rule>(STAT_CD = 'HELD' AND CAPTURED_QTY = 0 AND RELEASED_QTY = 0 AND END_DTM IS NULL) OR (STAT_CD = 'SETTLED' AND CAPTURED_QTY + RELEASED_QTY = RESERVED_QTY AND END_DTM IS NOT NULL) OR (STAT_CD = 'RELEASED' AND CAPTURED_QTY = 0 AND RELEASED_QTY = RESERVED_QTY AND END_DTM IS NOT NULL)</rule>
<generateInDDL>YES</generateInDDL>
</tableCheckConstraint>
