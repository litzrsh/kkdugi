<tableCheckConstraints itemClass="oracle.dbtools.crest.model.design.constraint.TableLevelConstraint">
<tableCheckConstraint id="548676EF-F32F-57C3-8B6A-768A5E485A8F" name="KKDUGI_CREDIT_TXN_CK_BAL">
<createdBy>litzrsh</createdBy>
<createdTime>2026-09-12 11:14:07 UTC</createdTime>
<ownerDesignName>kkdugi</ownerDesignName>
<rule>TXN_NO &gt; 0 AND DELTA_QTY &lt;&gt; 0 AND BEFORE_QTY &gt;= 0 AND AFTER_QTY &gt;= 0 AND AFTER_QTY = BEFORE_QTY + DELTA_QTY</rule>
<generateInDDL>YES</generateInDDL>
</tableCheckConstraint>
<tableCheckConstraint id="4366E4AA-0AA6-549F-B630-B0ACD9B7E516" name="KKDUGI_CREDIT_TXN_CK_SOURCE">
<createdBy>litzrsh</createdBy>
<createdTime>2026-09-12 11:14:07 UTC</createdTime>
<ownerDesignName>kkdugi</ownerDesignName>
<rule>(TXN_TP_CD = 'TOPUP' AND DELTA_QTY &gt; 0 AND ORDER_ID IS NOT NULL AND CHARGE_ID IS NULL AND ORIG_TXN_ID IS NULL) OR (TXN_TP_CD = 'CHARGE' AND DELTA_QTY &lt; 0 AND ORDER_ID IS NULL AND CHARGE_ID IS NOT NULL AND ORIG_TXN_ID IS NULL) OR (TXN_TP_CD = 'REVERSAL' AND DELTA_QTY &gt; 0 AND ORDER_ID IS NULL AND CHARGE_ID IS NULL AND ORIG_TXN_ID IS NOT NULL) OR (TXN_TP_CD = 'ADJUST' AND ORDER_ID IS NULL AND CHARGE_ID IS NULL AND ORIG_TXN_ID IS NULL)</rule>
<generateInDDL>YES</generateInDDL>
</tableCheckConstraint>
