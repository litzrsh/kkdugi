<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kkdugi.app.menu.mapper.MenuMapper">
  <resultMap id="menuLabelResultMap" type="kkdugi.app.menu.models.MenuLabel">
    <id property="menuId" column="menu_id"/>
    <result property="title" column="menu_nm"/>
    <result property="remarks" column="menu_dc"/>
  </resultMap>

  <select id="findLabels" resultMap="menuLabelResultMap">
    /* QueryID=kkdugi.app.menu.mapper.MenuMapper.findLabels */
    SELECT menu_id, menu_nm, menu_dc
    FROM kkdugi_menu_lang
    WHERE lang_cd = #{langCode}
      AND menu_id IN
      <foreach collection="menuIds" item="id" open="(" separator="," close=")">
        #{id}
      </foreach>
  </select>
</mapper>
