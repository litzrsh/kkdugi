<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kkdugi.core.models.CommonMapper">

  <!-- BaseModel의 감사 필드 매핑. 도메인별 resultMap이 이를 extends해
       reg_dtm/reg_id/upd_dtm/upd_id 매핑을 반복하지 않는다. -->
  <resultMap id="baseResultMap" type="kkdugi.core.models.BaseModel">
    <result property="createdAt" column="reg_dtm"/>
    <result property="creatorId" column="reg_id"/>
    <result property="updatedAt" column="upd_dtm"/>
    <result property="updaterId" column="upd_id"/>
  </resultMap>

</mapper>
