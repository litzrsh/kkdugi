<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kkdugi.core.i18n.mapper.CoreI18nMessageMapper">

  <resultMap id="Message" type="kkdugi.core.i18n.models.I18nMessage">
    <id column="MSG_CD" property="code" />
    <id column="LANG_CD" property="lang" />
    <result column="MSG_VAL" property="message" />
  </resultMap>

  <!--
      * QueryID=findAll
      * Description=Find all valid messages
      -->
  <select id="findAll" resultMap="Message">
<![CDATA[
/* QueryID=kkdugi.core.i18n.mapper.CoreI18nMessageMapper.findAll */
SELECT MSG_CD, LANG_CD, MSG_VAL
FROM KKDUGI_I18N_MSG
ORDER BY MSG_CD, LANG_CD
]]>
    </select>
</mapper>